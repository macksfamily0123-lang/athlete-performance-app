NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Phase 72.3.90 RC40 — Connected Trackers / Google Health (server-only secrets)
# NEVER prefix the service role, provider secrets, or encryption key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
TRACKER_TOKEN_ENCRYPTION_KEY=GENERATE_A_LONG_RANDOM_SECRET
NEXT_PUBLIC_APP_URL=https://YOUR-BETA-DOMAIN.vercel.app
TRACKER_APP_URL=https://YOUR-BETA-DOMAIN.vercel.app

# Google Health OAuth (Fitbit + Pixel Watch data)
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# Oura OAuth
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# WHOOP OAuth
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Strava OAuth
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
